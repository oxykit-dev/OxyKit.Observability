<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OxyKit.OpenTelemetry</RootNamespace>
    <Description>Optional OpenTelemetry OTLP wiring for OxyKit ASP.NET Core hosts (off by default).</Description>
    <PackageId>OxyKit.OpenTelemetry</PackageId>
    <Version>0.1.1</Version>
    <Authors>OxyKit</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://oxykit.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oxykit-dev/OxyKit.Observability</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oxykit;opentelemetry;otlp;observability</PackageTags>
    <PackageIcon>images/icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\OxyKit.OpenTelemetry.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\nuget\icon.png" Pack="true" PackagePath="images/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
</Project>
