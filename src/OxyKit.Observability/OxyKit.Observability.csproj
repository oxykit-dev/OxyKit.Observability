<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OxyKit.Observability</RootNamespace>
    <Description>JSON console logging and X-Correlation-Id helpers for OxyKit ASP.NET Core hosts.</Description>
    <PackageId>OxyKit.Observability</PackageId>
    <Version>0.1.0</Version>
    <Authors>OxyKit</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://oxykit.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oxykit-dev/OxyKit.Observability</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oxykit;logging;correlation;observability</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\OxyKit.Observability.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
